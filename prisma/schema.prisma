// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SeatStatus {
  AVAILABLE
  BOOKED
}

enum BookingStatus {
  PENDING
  PAID
  CANCELED
}

enum PaymentMethod {
  MPESA
  PAYPAL
}

enum PaymentStatus {
  SUCCESSFUL
  FAILED
}

model User {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  email        String    @unique
  phone        String?    @unique
  passwordHash String
  gender       Gender
  age          Int
  role         Role      @default(PASSENGER)
  avatarUrl  String?
  bookings     Booking[]
  tickets      Ticket[]
  createdAt    DateTime  @default(now())
}

model Bus {
  id          String  @id @default(cuid())
  plateNumber String  @unique
  totalSeats  Int
  busAvatar   String?
  driverId    String  @unique
  driver      Driver  @relation(fields: [driverId], references: [id])
  seats       Seat[]
  routes      Route[]
}

model Driver {
  id         String @id @default(cuid())
  firstName  String
  lastName   String
  email      String?   @unique
  passwordHash String?
  gender     Gender?
  age        Int?
  avatarUrl  String?
  phone      String? @unique
  licenseNo  String  @unique
  experience Int
  bus        Bus?
}

model Seat {
  id         String      @id @default(cuid())
  busId      String
  seatNumber Int
  bus        Bus         @relation(fields: [busId], references: [id])
  routeSeats RouteSeat[]
}

model Route {
  id          String      @id @default(cuid())
  departure   String
  destination String
  date        DateTime
  time        String
  amount      Float
  busId       String
  bus         Bus         @relation(fields: [busId], references: [id])
  bookings    Booking[]
  tickets     Ticket[]
  routeSeats  RouteSeat[]
}

model RouteSeat {
  id           String        @id @default(cuid())
  routeId      String
  seatId       String
  status       SeatStatus    @default(AVAILABLE)
  route        Route         @relation(fields: [routeId], references: [id])
  seat         Seat          @relation(fields: [seatId], references: [id])
  bookingSeats BookingSeat[]

  @@unique([routeId, seatId])
}

model Booking {
  id              String        @id @default(cuid())
  userId          String
  routeId         String
  passengerName   String
  passengerPhone  String
  passengerGender Gender
  status          BookingStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id])
  route           Route         @relation(fields: [routeId], references: [id])
  bookingSeats    BookingSeat[]
  payment         Payment?
}

model BookingSeat {
  id          String    @id @default(cuid())
  bookingId   String
  routeSeatId String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id])
  routeSeat   RouteSeat @relation(fields: [routeSeatId], references: [id])
  ticket      Ticket?
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  amountPaid    Float
  paymentMethod PaymentMethod
  transactionId String        @unique
  status        PaymentStatus @default(SUCCESSFUL)
  paymentDate   DateTime      @default(now())
  booking       Booking       @relation(fields: [bookingId], references: [id])
}

model Ticket {
  id            String      @id @default(cuid())
  passengerId   String
  bookingSeatId String      @unique
  routeId       String
  seatNumber    Int
  busPlate      String
  price         Float
  qrCode        String      @unique
  passenger     User        @relation(fields: [passengerId], references: [id])
  bookingSeat   BookingSeat @relation(fields: [bookingSeatId], references: [id])
  route         Route       @relation(fields: [routeId], references: [id])
}
